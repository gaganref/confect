import assert from "node:assert/strict";
import { createRequire } from "node:module";
import { resolve } from "node:path";

const require = createRequire(import.meta.url);
const convexRequire = createRequire(require.resolve("convex/package.json"));
const { build } = convexRequire("esbuild");

// Match convex/src/bundler/{index,debugBundle}.ts, including keepNames.
const dir = resolve("convex");
const result = await build({
  entryPoints: [resolve(dir, "schema.ts")],
  bundle: true,
  platform: "browser",
  format: "esm",
  target: "esnext",
  jsx: "automatic",
  outdir: "out",
  outbase: dir,
  conditions: ["convex", "module"],
  plugins: [
    {
      name: "convex-async-hooks-shim",
      setup(build) {
        build.onResolve({ filter: /^(node:)?async_hooks$/ }, (args) => ({
          path: args.path,
          namespace: "async-hooks-shim",
        }));
        build.onLoad({ filter: /.*/, namespace: "async-hooks-shim" }, () => ({
          contents: `export const AsyncLocalStorage = globalThis.AsyncLocalStorage;
export const AsyncResource = globalThis.AsyncResource;
export default { AsyncLocalStorage, AsyncResource };`,
          loader: "js",
        }));
      },
    },
  ],
  write: false,
  sourcemap: true,
  sourcesContent: false,
  splitting: true,
  chunkNames: "_deps/[hash]",
  treeShaking: true,
  minifySyntax: true,
  minifyIdentifiers: true,
  minifyWhitespace: false,
  keepNames: true,
  define: { "process.env.NODE_ENV": '"production"' },
  metafile: true,
  logLevel: "warning",
});
const modules = Object.entries(result.metafile.outputs).filter(([file]) =>
  file.endsWith(".js"),
);
assert.deepEqual(
  modules.map(([file, output]) => ({ file, imports: output.imports })),
  [{ file: "out/schema.js", imports: [] }],
);
const source = result.outputFiles.find((file) =>
  file.path.endsWith("/schema.js"),
).text;
const { default: schema } = await import(
  `data:text/javascript;base64,${Buffer.from(source).toString("base64")}`
);
assert.deepEqual(
  JSON.parse(schema.export()).tables.map((table) => table.tableName),
  ["items"],
);
console.log(
  "Generated schema bundles to one import-free module and exports the items table.",
);
