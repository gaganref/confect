import type { TestConfect } from "@confect/test";
import schema from "../../components/counter/convex/schema.js";

export function register(
  t: { readonly registerComponent: TestConfect.RegisterComponent },
  name: string,
): void {
  // convex-test finds the module root from a `_generated` key, and only Convex
  // writes the component's `_generated/`.
  t.registerComponent(name, schema, {
    "../../components/counter/convex/_generated/server.ts": () =>
      Promise.resolve({}),
    ...import.meta.glob("../../components/counter/convex/**/*.ts"),
  });
}
