{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "incremental": true,
    "tsBuildInfoFile": "node_modules/.cache/tsrs/tsconfig.tsbuildinfo",
    "rootDir": ".",
    "skipLibCheck": true,
    "isolatedDeclarations": false,
    "exactOptionalPropertyTypes": true,
    "lib": ["ESNext", "DOM"],
    "target": "ESNext",
    "moduleResolution": "Bundler",
    "module": "ESNext",
    "types": ["bun", "node"],
    "jsx": "react-jsx",
    "paths": {
      "@confect/core": ["./packages/core/src/index.ts"],
      "@confect/core/*": ["./packages/core/src/*"],
      "@confect/server": ["./packages/server/src/index.ts"],
      "@confect/server/*": ["./packages/server/src/*"],
      "@confect/js": ["./packages/js/src/index.ts"],
      "@confect/js/*": ["./packages/js/src/*"],
      "@confect/foldkit": ["./packages/foldkit/src/index.ts"],
      "@confect/foldkit/*": ["./packages/foldkit/src/*"],
      "@confect/react": ["./packages/react/src/index.ts"],
      "@confect/react/*": ["./packages/react/src/*"],
      "@confect/cli": ["./packages/cli/src/index.ts"],
      "@confect/cli/*": ["./packages/cli/src/*"],
      "@confect/test": ["./packages/test/src/index.ts"],
      "@confect/test/*": ["./packages/test/src/*"],
      "@confect/alchemy": ["./packages/alchemy/src/index.ts"],
      "@confect/alchemy/*": ["./packages/alchemy/src/*"],
      "~/*": ["./packages/server/test/mock-backend/fixtures/confect/*"]
    }
  },
  "include": [
    "*.ts",
    "scripts/**/*.ts",
    "packages/*/*.ts",
    "packages/*/test/**/*",
    "packages/cli/src/**/*",
    "tools/*/*.ts",
    "tools/*/src/**/*",
    "tools/*/test/**/*",
    "tools/local-backend/fixtures/**/*"
  ],
  "exclude": [
    "tools/oxlint-rules",
    "tools/test-types",
    // Convex writes these git-ignored folders on a push, with unused imports
    // and an incorrect nested API import. Nothing Confect writes imports them.
    "tools/local-backend/fixtures/components/*/convex/_generated",
    "tools/local-backend/fixtures/guard/components/*/convex/_generated",
    // Its generated imports exist only in the copy a test runs codegen on.
    "packages/alchemy/test/fixtures/init-app"
  ]
}
