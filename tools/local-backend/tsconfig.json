{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ESNext", "DOM"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "target": "ESNext"
  },
  "include": ["src", "fixtures"],
  // Convex writes these git-ignored folders on a push, with unused imports
  // and an incorrect nested API import. Nothing Confect writes imports them.
  "exclude": [
    "fixtures/components/*/convex/_generated",
    "fixtures/guard/components/*/convex/_generated"
  ]
}
