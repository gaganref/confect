{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ESNext", "DOM"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "target": "ESNext"
  },
  "include": ["src", "fixtures"],
  // Convex emits unused imports and an incorrect nested API import in these
  // unused helpers. Imported ComponentApi types remain in the checked graph.
  "exclude": ["fixtures/components/*/convex/_generated"]
}
