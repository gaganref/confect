"http.ts": moduleSource("../../convex/http.ts"),
"notes.ts": moduleSource("../../convex/notes.ts"),
"schema.ts": moduleSource("../../convex/schema.ts"),
"tasks.ts": moduleSource("../../convex/tasks.ts"),
}, components: {"first": firstKit("first"),}, packagedSources: undefined };
export default backend;
export const TestBackend = $TestBackend.make(backend, {
